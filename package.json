{
  "name": "timermcp",
  "version": "1.2.0",
  "description": "TimerMCP \u2014 a millisecond-precision talking stopwatch for Claude via MCP. Voice-start, voice-stop, latency-cancelling math, gamified live wall dashboard (XP, ranks, achievements, streaks), personal bests, speedrun splits, shareable result cards.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "timermcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "sample-result-card.svg"
  ],
  "scripts": {
    "build": "tsc && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch{}\"",
    "start": "node dist/index.js",
    "smoke": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julanbasnet/timermcp.git"
  },
  "homepage": "https://timermcp.com",
  "bugs": "https://github.com/julanbasnet/timermcp/issues",
  "keywords": [
    "mcp",
    "timer",
    "stopwatch",
    "claude",
    "speedrun",
    "pomodoro"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}